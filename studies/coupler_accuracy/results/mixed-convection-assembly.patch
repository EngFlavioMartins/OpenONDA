         boundary_patch: Boundary patch info
         mesh_data: Mesh connectivity
+        component: Velocity component index for a directional mixed boundary.
 
     Returns:
         dict: Flux coefficients for boundary
@@ -368,10 +370,42 @@ def assemble_convection_term_boundary(
     b_elem_start = start_face - n_interior_faces
     b_elem_indices = np.arange(n_cells + b_elem_start, n_cells + b_elem_start + n_faces)
 
+    if strategy is BoundaryStrategy.NORMAL_VALUE_TANGENTIAL_GRADIENT:
+        if geo_data is None or component not in (0, 1, 2):
+            raise ValueError(
+                "normalValueTangentialGradient convection requires geometry "
+                "and a velocity component index"
+            )
+        sf = np.asarray(geo_data["face_area_vector"])[b_face_indices]
+        area = np.linalg.norm(sf, axis=1)
+        if np.any(area <= 1.0e-14):
+            raise ValueError("Mixed convection boundary contains a degenerate face")
+        normal_component = sf[:, component] / area
+        # U_b = (I - nn^T) U_owner + n U_normal + d g_t. For a
+        # segregated component solve, retain the diagonal of the tangential
+        # projector implicitly; cross-components remain in the explicit term.
+        # Treating the complete reconstructed value as Dirichlet instead lags
+        # this owner dependence and gives the pressure correction a different
+        # momentum diagonal. The flux at the assembly state is unchanged.
+        flux_cf = boundary_advective_face_flux * (1.0 - normal_component**2)
+        flux_ff = np.zeros_like(flux_cf)
+        flux_vf = (
+            boundary_advective_face_flux * scalar_field[b_elem_indices]
+            - flux_cf * scalar_field[owners_b]
+        )
+        result = {
+            "flux_cf": flux_cf,
+            "flux_ff": flux_ff,
+            "flux_vf": flux_vf,
+            "face_indices": b_face_indices,
+        }
+        if include_total_flux:
+            result["flux_tf"] = flux_cf * scalar_field[owners_b] + flux_vf
+        return result
+
     if strategy in (
         BoundaryStrategy.FIXED_VALUE,
         BoundaryStrategy.NO_SLIP,
-        BoundaryStrategy.NORMAL_VALUE_TANGENTIAL_GRADIENT,
     ):
         # A Dirichlet face value is authoritative for either flow direction.
         flux_cf = np.zeros_like(boundary_advective_face_flux)
