# ===============================
# OpenFOAM/CFD and simulation outputs
# ===============================
# Time directories > 0 (OpenFOAM simulation results)
# Keep 0/ and 0.orig/ (initial conditions), ignore time directories > 0
[1-9]*/
[1-9]*.[0-9]*/
0.[0-9]*/
0.[0-9]*[0-9]*/

# OpenFOAM mesh and processor data (generated files)
**/polyMesh/points
**/polyMesh/faces
**/polyMesh/owner
**/polyMesh/neighbour
**/polyMesh/boundary
processor*/

# Solution and data directories
**/solution/
**/Solution/
**/referenceFlow/
Data/
Raw/
data/
raw/
samples/
postProcessing/

# Log files
log.*
*.log

# ===============================
# Data, results, and scientific formats
# ===============================
# Large binary data files - use DVC for these
*.h5
*.hdf5
*.npz

# VTK/ParaView files (except in specific approved locations)
*.vtp
*.vtu
*.pvd
*.pvtu

# Mesh files
*.msh
*.stl
*.ply
*.obj

# Other simulation data
*.xdmf
*.out
*.dat
*.csv

# VPM JSON outputs
vpm*.json

# ===============================
# Keep visualization outputs in git
# ===============================
# Images and plots are small and should be versioned
!**/*.png
!**/*.pdf
!**/*.jpg
!**/*.jpeg
!**/*.svg

# ===============================
# Specific tutorial data management
# ===============================
# Keep small reference text files but ignore large data
!tutorials/**/README*.md
!tutorials/**/README*.txt
!tutorials/**/*.py
!tutorials/**/*.sh
tests/**/referenceFlow/**