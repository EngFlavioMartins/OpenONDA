# ===============================
# Python build, cache, and eggs
# ===============================
__pycache__/
.taichi_cache/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.pytest_cache
.ruff_cache
.complexipy_cache
.coverage
.claude
.github
.mypy_cache

dist/
build/

# ===============================
# Jupyter Notebooks
# ===============================
.ipynb_checkpoints/
*.ipynb

# ===============================
# IDE/editor files
# ===============================
.vscode/
.idea/
*.swp
*.swo
*.suo

# ===============================
# OS-specific files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Virtual environments
# ===============================
.env/
.venv/
venv/

# ===============================
# Logs and temporary files
# ===============================
*.log
*.tmp
*.bak

# ===============================
# C++/build artifacts
# ===============================
*.cpp
# Cython annotation reports (regenerated by build_solvers.sh)
source/solvers/**/*.html
*.obj
*.exe
*.dll
*.lib
*.a
**/Make/linux64Gcc*/
# wmake-generated symlink farms (regenerated on build; never commit)
source/solvers/OFW/**/lnInclude/

# ===============================
# OpenFOAM/CFD and simulation outputs
# ===============================
# Time directories > 0 (OpenFOAM simulation results)
# Keep 0/ and 0.orig/ (initial conditions), ignore time directories > 0
[1-9]*/
[1-9]*.[0-9]*/
0.[0-9]*/
0.[0-9]*[0-9]*/

# OpenFOAM runtime mesh (regenerated from polyMesh.orig / cartesianMesh at run
# time). The canonical mesh ships as constant/polyMesh.orig and IS kept in git.
**/constant/polyMesh/
# Decomposed parallel data (regenerated by decomposePar — never committed).
processor*/

# ParaView marker files and exported scenes (regenerated on demand)
*.foam
**/VTK/

# Solution and data directories (results → DVC, never git)
**/solution/
**/Solution/
**/referenceFlow/
Data/
Raw/
data/
raw/
samples/
postProcessing/

# Log files
log.*
*.log

# ===============================
# Data, results, and scientific formats
# ===============================
# Large binary data files - use DVC for these
*.h5
*.hdf5
*.npz

# VTK/ParaView files (regenerated by mesh/post scripts)
*.vtk
*.vtp
*.vtu
*.pvd
*.pvtu

# Mesh files
*.msh
*.stl
*.ply
*.obj

# Other simulation data
*.xdmf
*.out
*.dat
*.csv

# VPM JSON outputs
vpm*.json

# ===============================
# Keep visualization outputs in git
# ===============================
# Images and plots are small and should be versioned
!**/*.png
!**/*.pdf
!**/*.jpg
!**/*.jpeg
!**/*.svg

# ===============================
# Specific tutorial data management
# ===============================
# Keep small reference text files but ignore large data
!tutorials/**/README*.md
!tutorials/**/README*.txt
!tutorials/**/*.py
!tutorials/**/*.sh
tests/**/referenceFlow/**