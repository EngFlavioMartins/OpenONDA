# IDE/editor files
# ===============================
.vscode/
.idea/
*.swp
*.swo
*.suo

# ===============================
# OS-specific files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Virtual environments
# ===============================
.env/
.venv/
venv/

# ===============================
# Logs and temporary files
# ===============================
*.log
*.jsonl
*.tmp
*.bak

# ===============================
# Build artifacts
# ===============================
source/solvers/**/*.html
*.obj
*.exe
*.dll
*.lib
*.a
**/Make/linux64Gcc*/
# ===============================
# CFD and simulation outputs
# ===============================
# Decomposed parallel data is regenerated and never committed.
processor*/

# ParaView marker files and exported scenes (regenerated on demand)
**/VTK/

# Solution and data directories (results → DVC, never git)
**/solution/
**/Solution/
# Fully-meshed reference setups are versioned; their solution/ data remain ignored above.
Data/
Raw/
data/
raw/
postProcessing/
/artifacts/

# Log files
log.*
*.log

# ===============================
# Data, results, and scientific formats
# ===============================
# Large binary data files - use DVC for these
*.h5
*.hdf5
*.npz

# VTK/ParaView files (regenerated by mesh/post scripts)
*.vtk
*.vtp
*.vtu
*.vts
*.pvd
*.pvtu
*.pvsm

# Mesh files
*.msh
*.stl
*.ply
*.obj

# Fixed geometry inputs required by the native cubeFlow tutorials
!tutorials/coupled_FVM_VPM/cubeFlow/assets/cube.stl
!tutorials/coupled_FVM_VPM/cubeFlow/referenceFlow/assets/cube.stl

# Other simulation data
*.xdmf
*.out
*.dat
*.csv

# VPM JSON outputs
vpm*.json

# ===============================
# Keep visualization outputs in git
# ===============================
# Images and plots are small and should be versioned
!**/*.png
!**/*.pdf
!**/*.jpg
!**/*.jpeg
!**/*.svg

# ===============================
# Specific tutorial data management
# ===============================
# Keep small reference text files but ignore large data
!tutorials/**/README*.md
!tutorials/**/README*.txt
!tutorials/**/*.py
!tutorials/**/*.sh
tests/**/referenceFlow/**

# Processed sampler output is part of each reproducible tutorial. Any samples/
# directory outside an ignored solution/ tree is therefore versioned by default.
!**/samples/
!**/samples/**

# Restart/checkpoint formats never belong in Git, even if accidentally written
# below samples/. The pre-commit size gate provides an additional safeguard.
**/samples/**/*.h5
**/samples/**/*.hdf5
**/samples/**/*.xdmf
**/samples/**/*.npz

# Full reference-flow volume slices are generated data. Keep the compact CSV
# histories in Git and leave local slices untouched when they are untracked.
tutorials/coupled_FVM_VPM/cubeFlow/referenceFlow/samples/*.vts
tutorials/coupled_FVM_VPM/cubeFlow/referenceFlow/samples/*.pvd

# direnv
.envrc
