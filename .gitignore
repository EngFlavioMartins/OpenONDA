*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.pytest_cache
.ruff_cache
.complexipy_cache
.coverage
.claude
.mypy_cache
.matplotlib/
.cache/

dist/
build/

# ===============================
# Jupyter Notebooks
# ===============================
.ipynb_checkpoints/
*.ipynb

# ===============================
# IDE/editor files
# ===============================
.vscode/
.idea/
*.swp
*.swo
*.suo

# ===============================
# OS-specific files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Virtual environments
# ===============================
.env/
.venv/
venv/

# ===============================
# Logs and temporary files
# ===============================
tmp/
*.log
*.jsonl
*.tmp
*.bak
**/.openonda_run.lock
**/.openonda_run.lock

# ===============================
# Build artifacts
# ===============================
source/solvers/**/*.html
*.obj
*.exe
*.dll
*.lib
*.a
**/Make/linux64Gcc*/
# ===============================
# CFD and simulation outputs
# ===============================
# Decomposed parallel data is regenerated and never committed.
processor*/

# ParaView marker files and exported scenes (regenerated on demand)
**/VTK/

# Solution and data directories (results are never committed)
**/solution/
**/Solution/
# Fully-meshed reference setups are versioned; their solution/ data remain ignored above.
Data/
Raw/
data/
raw/
postProcessing/
**/artifacts/

# Log files
log.*
*.log

# ===============================
# Data, results, and scientific formats
# ===============================
# Large binary data files
*.h5
*.hdf5
*.npz

# Small, immutable native-solver regression inputs (provenance in the fixture README).
!tests/mesh_parity/fixtures/*.npz

# VTK/ParaView files (regenerated by mesh/post scripts)
*.vtk
*.vtp
*.vtu
*.vts
*.pvd
*.pvtu
*.pvsm

# Mesh files
*.msh
*.stl
*.ply
*.obj

# Fixed geometry inputs required by the native tutorials
!tutorials/fvm/cartesian_mesher/assets/object.stl
!tutorials/coupled_fvm_vpm/02_cube_flow/assets/cube.stl
!tutorials/coupled_fvm_vpm/02_cube_flow/reference_flow/assets/cube.stl
!tutorials/coupled_fvm_vpm/01_cylinder_shedding_flow/assets/cylinder_long.stl
!tutorials/coupled_fvm_vpm/01_cylinder_shedding_flow/reference_flow/assets/cylinder_long.stl

# Other simulation data
*.xdmf
*.out
*.dat
*.csv

# Digitized literature reference curves plotted against sampled results
!tutorials/vpm/01_lamb_oseen_vortex/assets/references/*.csv

# Small, inspectable qualification tables shipped with the surface-interaction tutorial
!tutorials/vpm/08_surface_interaction/studies/*.csv

# VPM JSON outputs
vpm*.json

# ===============================
# Keep visualization outputs in git
# ===============================
# Images and plots are small and should be versioned
!**/*.png
!**/*.pdf
!**/*.jpg
!**/*.jpeg
!**/*.svg

# ===============================
# Specific tutorial data management
# ===============================
# Keep small reference text files but ignore large data
!tutorials/**/README*.md
!tutorials/**/README*.txt
!tutorials/**/*.py
!tutorials/**/*.sh
tests/**/reference_flow/**

# Processed sampler output is durable cross-device post-processing data.
# Version every samples/ tree, including samples produced by grid studies.
!**/samples/
!**/samples/**

# Restart/checkpoint formats never belong in Git, even if accidentally written
# below samples/. The pre-commit size gate provides an additional safeguard.
**/samples/**/*.h5
**/samples/**/*.hdf5
**/samples/**/*.xdmf
**/samples/**/*.npz

# direnv
.envrc
