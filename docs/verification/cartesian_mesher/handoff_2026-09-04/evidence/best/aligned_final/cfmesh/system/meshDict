FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      meshDict;
}
surfaceFile "constant/triSurface/openonda_parity_geometry.stl";
maxCellSize 0.5;
boundaryCellSize 0.25;
minCellSize 0.25;

renameBoundary
{
    newPatchNames
    {
        body
        {
            newName body;
            type wall;
        }
        front_back
        {
            newName front_back;
            type patch;
        }
        inlet
        {
            newName inlet;
            type patch;
        }
        outlet
        {
            newName outlet;
            type patch;
        }
        walls
        {
            newName walls;
            type patch;
        }
    }
}

workflowControls
{
    stopAfter boundaryLayerRefinement;
}
